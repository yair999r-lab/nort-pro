{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "client",
      "type": "shell",
      "command": "cd client ; npm i ; npm start",
      "problemMatcher": [],
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "pie-chart"
      },
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoExit", "-Command"]
        }
      }
    },
    {
      "label": "server",
      "type": "shell",
      "command": "cd server ; npm i ; npm run dev",
      "problemMatcher": [],
      "icon": {
        "color": "terminal.ansiMagenta",
        "id": "database"
      },
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoExit", "-Command"]
        }
      }
    },
    {
      "label": "git",
      "type": "shell",
      "command": "git checkout main && git pull && exec bash",
      "problemMatcher": [],
      "icon": {
        "color": "terminal.ansiWhite",
        "id": "git-branch"
      },
      "isBackground": true,
      "options": {
        "shell": {
          "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
          "args": ["-c"]
        }
      }
    },
    {
      "label": "Run All Terminals",
      "dependsOn": ["client", "server", "git"],
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
