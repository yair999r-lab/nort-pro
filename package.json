{
  "name": "generic-table",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "libs/*"
  ],
  "scripts": {
    "build": "nx run-many --target=build --all --parallel=8",
    "build:libs": "nx run-many --target=build --projects=tag:type:lib --parallel=5",
    "build:apps": "nx run-many --target=build --projects=tag:type:app --parallel=5",
    "dev:libs": "nx run-many --target=dev --projects=tag:type:lib --parallel=8 --output-style=stream",
    "dev": "nx run-many --target=dev --all --parallel=8 --output-style=stream"
  },
